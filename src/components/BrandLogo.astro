---
import waxweal_placeholder_graphic from '../../public/waxweal_placeholder_graphic.png';
import waxweal_logo_test from '../../public/waxweal_logo_test.png'
import SideTitle from './SideTitle.astro';
---

<div id="side">
    <SideTitle />
    <div class="brand-logo">
    <div />
            <div>
                <img src={waxweal_logo_test.src} id="bottom"/>
                <img 
                    src={waxweal_placeholder_graphic.src} 
                    id="wax-seal"
                    />
            </div>
        </div>
    </div>

<style>

    @import url('https://fonts.googleapis.com/css2?family=Charmonman:wght@400;700&display=swap');

    #side {
        display: grid;
        grid-template-columns: 40% 60%;    
        width: 100%;
        align-items: center;

        @media screen and (max-width: 1400px) {
            grid-template-columns: 100%;

        }
    }

    #wax-seal {
        margin: auto;
        display: inline;
        z-index: 2;
        @media screen and (max-width: 1400px) {
            display: none;
        }
    }
    #bottom {
        display: inline;
        height: 300px;
        width: 200px;
        z-index: 1;
        transform: rotate(90deg);
        position: absolute;
        /* right: calc(60% - 300px); */
        margin-left: -250px;
        margin-top: 150px;
        align-self: center;
        justify-self: center;

        @media screen and (max-width: 1400px) {
            display: none;
        }
    }

    .brand-logo {
        width: calc(110% + 120px);
        margin-left: calc(-10% - 120px);
        display: grid;
        grid-template-columns:40% 60%;
        align-items: center; 
        height: 100vh;
        background: black;

        @media screen and (max-width: 1400px) {
            display: none;
        }
    }


</style>

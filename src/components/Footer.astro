---
import banner_lace2 from '/public/banner_lace2.png'
---

<section id="footer">
        <div>
“And when she had spoken such a rhapsody, she would press me more
closely in her trembling embrace, and her lips in soft kisses gently
glow upon my cheek.“

–Carmilla, by Joseph Sheridan Le Fanu, 1872
</div>
<img src={banner_lace2.src} id="banner" />
<div>Copyright © 2026 Waxweal</div>
</section>

<style>
    #footer {
        width: 60%;
        padding-top: 100px;
        padding-left: 40%;
		background: red; 
		background: linear-gradient(180deg,rgba(0, 0, 0, 1) 0%, red 100%);
        color: white;
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;

        @media screen and (max-width: 1400px) {
          padding-left: 20%;
          padding-right: 20%;
        }
        
    }

    #footer > div {
        margin: auto;
        text-align: center;
        width: 30%;
        margin-bottom: 50px;

        @media screen and (max-width: 1400px) {
          width: 100%;
        }

    }
    #banner {
        margin: auto;
        width: 50%;
        height: auto;
    }

</style>
---
const posts = Object.values(import.meta.glob("../text/Announcements/*.md", { eager: true }));
---

<section id="announcements">
        <div class="title">ANNOUNCEMENTS</div>
        <div class="content">{posts.map((post: any, index) => {
                const isEven = index % 2 == 0;
                return (
                    <div class={"post-outer " + (isEven ? "slide-left" : "slide-right")}>
                    <h1>{post.frontmatter.date}</h1>
                    <div class="post-inner">
                        <h2>{post.frontmatter.title}</h2>
                        <Fragment set:html={post.compiledContent()} />
                    </div>
                    <img src={post.frontmatter.img} class="post-image"/>
                </div>
                    
                )
            
        })}
        </div>
</section>

<style>
        @keyframes slide-fade-in-left {
        from { opacity: 0; margin-left: 200px; }
        to { opacity: 1; margin-left: 0px; }
    }

    @keyframes slide-fade-in-right {
        from { opacity: 0; margin-right: 200px; }
        to { opacity: 1; margin-right: 0px; }
    }

    .slide-left {
        opacity: 1;
        animation: slide-fade-in-left 2s ease;
    }

    .slide-right {
        opacity: 1;
        animation: slide-fade-in-right 2s ease;
    }

    .post-image {
        width: 50%;
    }
    .post-outer {
        border-top: white dotted 2px;
        padding-top: 50px;
        margin-right: 10%;
        display: flex;
        flex-direction: row;

        opacity: 1;
        animation: slide-fade-in-left 2s ease;
    }

    .post-inner {
        margin: 0px 20px 50px 20px;
        vertical-align: top;
    }

    h1 {
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1.2;
        color: white;
        font-family: "Red Hat Display", sans-serif;
        color: #ff540a;
    }

    h2 {
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1.2;
        color: white;
        font-family: "Red Hat Display", sans-serif;
    }

    .content {
        /* justify-self: start; */
        font-family: "Atkinson Hyperlegible Next", sans-serif;
        font-size: 15px;
        font-weight: 400;
        line-height: 25.5px;
        margin-left: -50px;

        a {
            color: #ff540a;
            text-decoration: none;
            border-bottom: #ff540a solid 1px;
        }
    }


    #announcements {
        display: grid;
        grid-template-columns: calc(30% + 120px) calc(70% - 120px);
        align-items: start;        
        color: white;
        width: 100%;
        padding: 100px;
        padding-top: 0px;
        /* padding-left: 0px; */
		background: #360e46; 
		background: linear-gradient(180deg, #360e46 0%, rgba(0, 0, 0, 1) 100%);
        @media screen and (max-width: 1400px) {
           grid-template-columns: 100%;
        }
    }

    .title {
        font-size: 40px;
        z-index: 3;

        @media screen and (max-width: 1400px) {
           position: relative;
           margin-left: -50px;
        }
    }

    #announcements > div {
        width: 100%
    }
</style>
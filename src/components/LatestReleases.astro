---
const posts = Object.values(import.meta.glob("../text/LatestReleases/*.md", { eager: true }));
---

<section id="latest">
        <div class="title">LATEST RELEASES</div>
        <div class="content">{posts.map((post: any, index) => {
            if (index == 0) {
                return (
                <div class="post-inner">
                    <img src={post.frontmatter.logo} class="logo" />
                    <h1>{post.frontmatter.title}</h1>
                    <div>{post.frontmatter.subtitle}</div>
                    <h2>{post.frontmatter.role}</h2>
                    <Fragment set:html={post.compiledContent()} />
                    </div>
                )
            } else {
                return (
                    <div class="post-outer">
                    <img src={post.frontmatter.logo} class="thumbnail" />
                    <div class="post-inner">
                        <h1>{post.frontmatter.title}</h1>
                        <div>{post.frontmatter.subtitle}</div>
                        <h2>{post.frontmatter.role}</h2>
                        <Fragment set:html={post.compiledContent()} />
                        </div>
                    </div>
                )
            }
            
        })}
        </div>       
</section>

<style>
    .logo {
        max-width: 90%
    }

    .thumbnail {
        vertical-align: middle;
        max-width: 30%;
        margin-right: 50px;
    }

    .post-outer {
        border-top: white dotted 2px;
        padding-top: 50px;
        margin-right: 10%;
        display: flex;
        flex-direction: row;
    }

    .post-inner {
        margin: 0px 20px 50px 0px;
        vertical-align: top;
    }

    h1 {
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1.2;
        color: white;
        font-family: "Red Hat Display", sans-serif;
    }

    h2 {
        font-family: "Red Hat Display", sans-serif;
        font-size: 20px;
        font-weight: 400;
		color: rgba(255, 255, 255, 0.6);
    }

    .content {
        /* justify-self: start; */
        font-family: "Atkinson Hyperlegible Next", sans-serif;
        font-size: 15px;
        font-weight: 400;
        line-height: 25.5px;
        margin-left: -50px;

        a {
            color: #ff540a;
            text-decoration: none;
            border-bottom: #ff540a solid 1px;
        }
    }


    #latest {
        display: grid;
        grid-template-columns: calc(30% + 120px) calc(70% - 120px);
        align-items: start;        
        color: white;
        width: 100%;
        padding: 100px;
        padding-top: 0px;
		background: #360e46; 
		background: linear-gradient(180deg,rgba(0, 0, 0, 1) 0%, #360e46 100%);
    }

    .title {
        font-size: 40px;
        z-index: 3;
    }

    #latest > div {
        width: 100%;
    }
    
</style>
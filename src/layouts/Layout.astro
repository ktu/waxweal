---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';
import Side from '../components/Side.astro';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="fade">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Waxweal by Runa Liore Winters</title>
		<ClientRouter />
	</head>
	<body>
		<Header />
		<Side />
		<div class="base"></div>
		<slot />
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		overflow-x: hidden;
		margin: 0;
	}

	.base {
		height: 100%;
        background: linear-gradient(130deg,rgba(54, 14, 70, 1) 0%, rgba(0, 0, 0, 1) 50%); 
	}
</style>

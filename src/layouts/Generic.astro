---

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';
import Side from '../components/Side.astro';
import SideContent from '../components/SideContent.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Waxweal by Runa Liore Winters</title>
	</head>
	<body>
		<Header />
		<Side />
		<div class="base">
			<SideContent />
			<slot />
		</div>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		overflow-x: hidden;
		margin: 0;
		height: 100%;
	}

	.base {
		height: 100%;
        background: linear-gradient(130deg,rgba(54, 14, 70, 1) 0%, rgba(0, 0, 0, 1) 50%); 
		color: white;
        display: grid;
        grid-template-columns:40% 60%;
        align-items: start;        
        color: white;
        width: 100%;
        padding: 100px;
        padding-top: 100px;
        padding-left: 0px;
		background: #360e46; 
		background: linear-gradient(180deg, #360e46 0%, rgba(0, 0, 0, 1) 100%);

    }

    .title {
        font-size: 50px;
        padding-left: 100px;
        z-index: 3;
    }

    .base > div {
        width: 90%
    }
</style>

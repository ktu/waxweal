---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';
import Side from '../components/Side.astro';
import SideTitle from '../components/SideTitle.astro';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="fade">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Waxweal by Runa Liore Winters</title>
		<ClientRouter />
	</head>
	<body>
		<Header />
		<Side />
		<div class="base">
			<SideTitle />
			<slot />
		</div>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		overflow-x: hidden;
		margin: 0;
		height: 100%;
	}

	.base {
		height: 100%;
		color: white;
        display: grid;
        grid-template-columns:40% 60%;
        color: white;
        width: 100%;
        padding: 100px;
        padding-top: 100px;
        padding-left: 0px;
		background: black; 
		background: linear-gradient(10deg, #360e46 0%,  rgba(0, 0, 0, 1) 50%);

        @media screen and (max-width: 1400px) {
          grid-template-columns: 100%;
		  padding-top: 0px;
		  align-content: start;
        }
    }

    .title {
        font-size: 50px;
        padding-left: 100px;
        z-index: 3;
    }

    .base > div {
        width: 90%;

		@media screen and (max-width: 1400px) {
          width: 100%;
        }
    }
</style>
